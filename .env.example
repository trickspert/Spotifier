# Copy this file to ".env" and paste your Client ID from https://developer.spotify.com/dashboard
# (You can also paste the Client ID straight into the app's Connect screen instead.)
VITE_SPOTIFY_CLIENT_ID=

# Optional. Defaults to the address the app is opened at, e.g. http://127.0.0.1:5173/
# It must match a Redirect URI in your Spotify app settings EXACTLY.
VITE_SPOTIFY_REDIRECT_URI=
